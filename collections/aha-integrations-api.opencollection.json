          },
          "http": {
            "method": "GET",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/products/:product_id/integrations",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "ProductId identifier"
              },
              {
                "name": "{}",
                "value": "null",
