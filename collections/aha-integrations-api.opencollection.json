              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List integrations for an account"
        },
        {
          "info": {
            "name": "Create an integration for an account",
            "type": "http"
          },
          "http": {
