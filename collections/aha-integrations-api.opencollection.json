            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
