              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Enable integration"
        },
        {
          "info": {
            "name": "Get a specific integration by service name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/products/:product_id/integrations/:service_name",
            "params": [
              {
                "name": "product_id",
                "value": "",
                "type": "path",
                "description": "ProductId identifier"
              },
              {
                "name": "service_name",
                "value": "",
                "type": "path",
                "description": "ServiceName identifier"
              }
