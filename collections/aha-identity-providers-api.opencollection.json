{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aha! Account backups Identity providers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
      "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Identity providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List active identity providers that can be used for SSO",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/identity_providers",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List active identity providers that can be used for SSO"
        },
        {
          "info": {
            "name": "Get a specific identity provider",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/identity_providers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id identifier"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a specific identity provider"
        }
      ]
    }
  ],
  "bundled": true
}