        {
          "id": "e6f88ca6-862d-477b-9659-5b000cf07709",
          "name": "List account backups",
          "request": {
            "name": "List account backups",
            "description": {
              "content": "Account backups let you create a complete off-site backup of your Aha! account.\nThey can be [created](/api/resources/account_backups/create_an_account_backup),\n[listed](/api/resources/account_backups/list_account_backups), and [downloaded](/api/resources/account_backups/download_an_account_backup) via the API.\n\nAn account backup may only be created once every 24 hours.\n\nThe backup file contains a representation of all of the data in the Aha! account, including all relationships. \nIt does not contain user authentication data or integration secrets. The backup does not include any uploaded files.\n\n**[Account backups](https://www.aha.io/support/roadmaps/account/security-and-system-requirements/export-backup-aha-data) are an Enterprise+ exclusive feature.**",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "account_backups"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Aha! account domain",
                  "type": "any",
                  "value": "{{account-domain}}",
                  "key": "account-domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json; charset=utf-8"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://{account-domain}.aha.io/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://{account-domain}.aha.io/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
          "response": [
            {
              "id": "bf3b1ffc-f120-468e-be2e-ef6ada6dadcc",
