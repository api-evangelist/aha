{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aha! Account backups Integration changes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
      "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Integration changes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a record to an integration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/integration_changes",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint mimicks the \"Send to integration\" button on a record in the UI."
        }
      ]
    }
  ],
  "bundled": true
}