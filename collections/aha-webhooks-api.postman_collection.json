          "name": "Process a Jira webhook",
          "request": {
            "name": "Process a Jira webhook",
            "description": {
              "content": "Receives and processes a webhook from Jira when an issue is updated.\n\nTypical Jira webhook payload includes:\n- issue: { id: \"12345\", key: \"PROJ-123\", fields: { summary: \"Feature name\", status: { name: \"In Progress\" } } }\n- webhookEvent: \"jira:issue_updated\"\n- timestamp: \"2019-01-01T00:00:00Z\"",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "webhooks",
                ":token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "token",
                  "description": "(Required) Token identifier"
                },
                {
                  "description": "Your Aha! account domain",
                  "type": "any",
                  "value": "{{account-domain}}",
                  "key": "account-domain"
                }
              ]
            },
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://{account-domain}.aha.io/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://{account-domain}.aha.io/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
