          "http": {
            "method": "POST",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/:record_type/:id/record_links",
            "params": [
              {
                "name": "record_type",
                "value": "",
                "type": "path",
                "description": "RecordType identifier"
