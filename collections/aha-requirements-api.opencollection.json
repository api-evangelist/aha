{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aha! Account backups Requirements API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
      "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Requirements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a specific requirement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/requirements/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id identifier"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a specific requirement"
        },
        {
          "info": {
            "name": "Delete a requirement",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/requirements/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id identifier"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete a requirement"
        },
        {
          "info": {
            "name": "List requirements for a feature",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/features/:feature_id/requirements",
            "params": [
              {
                "name": "feature_id",
                "value": "",
                "type": "path",
                "description": "FeatureId identifier"
              },
              {
                "name": "updated_since",
                "value": "2019-01-01T00:00:00Z",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List requirements for a feature"
        },
        {
          "info": {
            "name": "Create a requirement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/features/:feature_id/requirements",
            "params": [
              {
                "name": "feature_id",
                "value": "",
                "type": "path",
                "description": "FeatureId identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a requirement"
        },
        {
          "info": {
            "name": "Convert a requirement to a feature",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{account-domain}.aha.io/api/v1/api/v1/requirements/:id/convert_to_feature",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id identifier"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://{account-domain}.aha.io/oauth/authorize",
              "accessTokenUrl": "https://{account-domain}.aha.io/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Convert a requirement to a feature"
        }
      ]
    }
  ],
  "bundled": true
}